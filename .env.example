# Never send any of these secrets in Telegram, commits, or chat.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user IDs. Empty means NO ONE is authorized.
TELEGRAM_ALLOWED_USER_IDS=[]

# OpenAI-compatible endpoint; include its API prefix, e.g. https://your-host/v1.
# No model name, vendor, fallback, or provider key is hardcoded.
AI_BASE_URL=
AI_API_KEY=
AI_MODELS_PATH=/models
AI_CHAT_PATH=/chat/completions
# Native provider "thinking" fields: explicitly configure only documented fields.
AI_EXTRA_BODY={}
AI_DISCOVERY_MAX_MODELS=100
AI_PROBE_CONCURRENCY=3
AI_MAX_TOOL_ROUNDS=8

BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
TRADING_MODE=paper
# Separate environment gate AND an exact Telegram confirmation are required for live trading.
LIVE_TRADING_ENABLED=false
ALLOW_HOST_TERMINAL=false
WORKSPACE_DIR=./workspace
DATA_DIR=./data
AUTO_APPROVE_ON_EDIT=false
LEARNING_ENABLED=false
DASHBOARD_TOKEN=

# Scanner/engine defaults. All percentages are 0..100, NOT fractions.
SYMBOLS=["BTCUSDT","ETHUSDT"]
TIMEFRAMES=["1m","3m","5m","15m"]
SCAN_INTERVAL_SEC=15
GUARD_INTERVAL_SEC=15
MANAGEMENT_INTERVAL_SEC=15
REPORT_INTERVAL_SEC=30
LEVERAGE=1
MAX_POSITIONS=2
RISK_PER_TRADE_PCT=0.5
MAX_MARGIN_PCT=10
MIN_AGREEING_STRATEGIES=2
MIN_CONFIDENCE=80
TF_MIN_CONFIDENCE=60
TP_MODE=POSITION
TPSL_METHOD=ADAPTIVE
PARTIAL_TP_LADDER=30@1,40@2
TRAILING_METHOD=ATR
TRAILING_CALLBACK=2
BREAKEVEN_THRESHOLD_PCT=3
TRAILING_TRIGGER_ROI_PCT=5
TRAILING_STOP_PCT=1
TRAILING_DISTANCE_PCT=1
LIQ_SL_DISTANCE_PCT=2
ACCOUNT_TP_USDT=0
ACCOUNT_SL_USDT=0
UNIVERSE_RANK=VOLUME
MIN_24H_VOLUME_USD=1000000
# Optional search connector (returns cited URLs); no fake results when unconfigured.
SEARCH_URL=
SEARCH_API_KEY=
# Optional per-capability provider models: chosen by user, NEVER guessed.
IMAGE_MODEL=
TTS_MODEL=
TTS_VOICE=
VIDEO_CONNECTOR=

# Extra engine risk controls; no setting is silently ignored.
MAX_TOTAL_RISK_PCT=2
MAX_DAILY_LOSS_PCT=3
MAX_STOP_DISTANCE_PCT=5
MIN_AGREEING_TIMEFRAMES=2
FIXED_R=2
MIN_REWARD_RISK=1.5
ATR_STOP_MULTIPLE=1.8
MAX_SCAN_SYMBOLS=20
MAX_MARKET_DATA_AGE_SEC=45
MAX_SPREAD_BPS=20
MAX_PRICE_DEVIATION_PCT=1
# Fee rate is a FRACTION (0.0006 = 0.06%); other *_PCT values are percentages.
TAKER_FEE_RATE=0.0006
PAPER_SLIPPAGE_BPS=2
PAPER_BALANCE_USDT=1000
REVERSAL_ENABLED=false
COOLDOWN_SEC=60
ENABLED_STRATEGIES=["ema","rsi","macd","volume","momentum","atr_breakout","funding_rate","supertrend","bollinger","ichimoku"]
# MANAGED default protects only bot-owned positions. ALL includes manual account positions.
ACCOUNT_GUARD_SCOPE=MANAGED
# Expert raw SDK mutation commands bypass scanner strategy checks: leave OFF normally.
ALLOW_RAW_EXCHANGE_MUTATIONS=false

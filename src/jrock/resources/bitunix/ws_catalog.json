  "tpsl": {
    "name": "tpsl",
    "source": "https://www.bitunix.com/api-docs/futures/websocket/private/Tp%20Sl%20Channel.html",
    "private": true,
    "request_parameters": [],
    "push_parameters": [
      {
        "name": "ch",
        "type": "String",
        "description": "Channel name: tpsl"
      },
      {
        "name": "ts",
        "type": "Int64",
        "description": "Gateway send time, Unix milliseconds. Do not use to order business events."
      },
      {
        "name": "data",
        "type": "<Object>",
        "description": "Always an object, not an array"
      },
      {
        "name": ">event",
        "type": "String",
        "description": "CREATE/UPDATE/CLOSE"
      },
      {
        "name": ">positionId",
        "type": "String",
        "description": "Position id"
      },
      {
        "name": ">orderId",
        "type": "String",
        "description": "Order id"
      },
      {
        "name": ">symbol",
        "type": "String",
        "description": "Symbol"
      },
      {
        "name": ">leverage",
        "type": "String",
        "description": "Leverage"
      },
      {
        "name": ">side",
        "type": "String",
        "description": "BUY/SELL"
      },
      {
        "name": ">positionMode",
        "type": "String",
        "description": "ONE_WAY/HEDGE"
      },
      {
        "name": ">status",
        "type": "String",
        "description": "NEW/CANCELED/SYSTEM_CANCELED/FILLED/FAILED"
      },
      {
        "name": ">ctime",
        "type": "String",
        "description": "ISO-8601 nanosecond create time, e.g. 2024-05-16T08:13:09.123456789Z. REST history uses milliseconds."
      },
      {
        "name": ">type",
        "type": "String",
        "description": "LIMIT/MARKET"
      },
      {
        "name": ">tpQty",
        "type": "String",
        "description": "Take-profit quantity (base coin); omitted if unused"
      },
      {
        "name": ">slQty",
        "type": "String",
        "description": "Stop-loss quantity (base coin); omitted if unused. Never Boolean or JSON null; string 0 sent as string 0."
      },
      {
        "name": ">tpStopType",
        "type": "String",
        "description": "MARK_PRICE/LAST_PRICE"
      },
      {
        "name": ">tpPrice",
        "type": "String",
        "description": "Take profit trigger price"
      },
      {
        "name": ">tpOrderType",
        "type": "String",
        "description": "LIMIT/MARKET"
      },
      {
        "name": ">tpOrderPrice",
        "type": "String",
        "description": "Take profit order price"
      },
      {
        "name": ">slStopType",
        "type": "String",
        "description": "MARK_PRICE/LAST_PRICE"
      },
      {
        "name": ">slPrice",
        "type": "String",
        "description": "Stop loss trigger price"
      },
      {
        "name": ">slOrderType",
        "type": "String",
        "description": "LIMIT/MARKET"
      },
      {
        "name": ">slOrderPrice",
        "type": "String",
        "description": "Stop loss order price"
      }
    ],
    "description": "After private login succeeds, channel tpsl is pushed automatically. data is ALWAYS object. CLOSE alone is not a final state: read event together with status. FILLED means TP/SL triggered and CHILD ORDER PLACED, NOT child full fill. Child fills are order channel or REST. INIT/PENDING_CANCEL/TRIGGER_WAIT_PLACE are not pushed; PART_FILLED is not a TPSL status.",
    "push_example": null,
    "notes": "Event/status: CREATE+NEW effective; UPDATE+NEW modified; CLOSE+CANCELED user canceled; CLOSE+SYSTEM_CANCELED system canceled; CLOSE+FILLED trigger succeeded/child placed; CLOSE+FAILED trigger failed."
  },
  "depth": {
    "name": "depth",
    "source": "https://www.bitunix.com/api-docs/futures/websocket/public/depth%20channel.html",
    "private": false,
    "request_parameters": [
      {
        "name": "op",
        "type": "String",
        "required": true,
        "required_literal": "Yes",
        "description": "Operation: subscribe or unsubscribe"
      },
      {
        "name": "args",
        "type": "List<Object>",
        "required": true,
        "required_literal": "Yes",
        "description": "List of channels to request subscription"
      },
      {
        "name": ">ch",
        "type": "String",
        "required": true,
        "required_literal": "Yes",
        "description": "depth_books,depth_book1,depth_book5,depth_book15"
      },
      {
        "name": ">symbol",
        "type": "String",
        "required": true,
        "required_literal": "Yes",
        "description": "Product ID e.g. ETHUSDT"
      }
    ],
    "push_parameters": [
      {
        "name": "ch",
        "type": "Object",
        "description": "Channel name (source type)"
      },
      {
        "name": "symbol",
        "type": "String",
        "description": "Product ID"
      },
      {
        "name": "ts",
        "type": "Int64",
        "description": "Timestamp"
      },
      {
        "name": "data",
        "type": "String",
        "description": "Subscription data (source type)"
      },
      {
        "name": ">a",
        "type": "List<String>",
        "description": "Seller depth"
      },
      {
        "name": ">b",
        "type": "List<String>",
        "description": "Buyer depth"
      }
    ],
    "description": "books: first full snapshot then changed depth; book1/book5/book15: respective levels pushed each time.",
    "push_example": {
      "ch": "depth_book1",
      "symbol": "BTCUSDT",
      "ts": 1775541541009,
      "data": {
        "b": [
          [
            "7403.89",
            "0.002"
          ]
        ],
        "a": [
          [
            "7405.96",
            "3.340"
          ]
        ]
      }
    },
    "notes": "Tables type ch as Object, data as String; examples are string and object. For books apply deltas, zero qty removes price; rebuild on reconnect. No sequence ID/checksum is documented here; use REST refresh to recover uncertainty."
  },
